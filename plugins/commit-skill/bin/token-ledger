#!/usr/bin/env node
'use strict';

// Records what a commit and a ship cost, in estimated API dollars, from the
// token usage Claude Code writes to its session transcripts. /commit calls
// `commit` and /ship calls `ship-begin` (silent) and `ship`, pasting stdout
// into their summary; a failure prints to stderr and leaves stdout empty, so
// the summary loses a line and nothing else. /ship lives in this plugin too,
// and finds this script on PATH.
//
// A session's spend past its last commit or ship is recorded too, as a
// `session` entry: the SessionEnd hook runs `session-end`, which starts
// `record-session` detached, and `sweep` records every session the hook missed.
//
// Subcommands: commit, ship-begin, ship, record-session, session-end, sweep,
// and report and stats, which are run by hand to read the ledger back.

const fs = require('fs');
const os = require('os');
const path = require('path');
const readline = require('readline');
const { execFileSync, spawn } = require('child_process');
const { isShipDocs } = require('../lib/commit-format');

const HOME = os.homedir();
const LEDGER = process.env.TOKEN_LEDGER_FILE || path.join(HOME, '.claude', 'token-ledger.jsonl');
const MARKERS = process.env.TOKEN_LEDGER_MARKERS || path.join(HOME, '.claude', 'token-ledger-ship-markers.json');
const PROJECTS = path.join(HOME, '.claude', 'projects');
const PRICES = JSON.parse(fs.readFileSync(path.join(__dirname, 'prices.json'), 'utf8'));

// ---------- small helpers ----------

function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith('--')) { out._.push(a); continue; }
    const eq = a.indexOf('=');
    if (eq > -1) out[a.slice(2, eq)] = a.slice(eq + 1);
    else if (argv[i + 1] && !argv[i + 1].startsWith('--')) out[a.slice(2)] = argv[++i];
    else out[a.slice(2)] = true;
  }
  return out;
}

function git(args, opts = {}) {
  return execFileSync('git', args, { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024, ...opts }).trim();
}

function gitSafe(args, opts) {
  // A null answer is the expected outcome here, so git's own error text is noise.
  try { return git(args, { stdio: ['ignore', 'pipe', 'ignore'], ...opts }); } catch { return null; }
}

// `repo` is the worktree's root and `project` the main checkout's. Every
// worktree of one repository shares the project, so it is the key a report
// groups on. Null outside a work tree.
function gitRoots(cwd) {
  const out = gitSafe([...(cwd ? ['-C', cwd] : []),
    'rev-parse', '--show-toplevel', '--path-format=absolute', '--git-common-dir']);
  if (!out) return null;
  const [repo, common] = out.split('\n');
  return { repo, project: path.dirname(common) };
}

function projectRoot() {
  const roots = gitRoots();
  return roots && roots.project;
}

function plural(n, word) {
  return `${n} ${word}${n === 1 ? '' : 's'}`;
}

// An entry belongs to a project when it records that root. An entry written
// before the field existed belongs when its worktree sits inside the root, or
// beside it as a `<root>-<name>` sibling, the older worktree layout.
function inProject(r, root) {
  if (r.project) return r.project === root;
  if (typeof r.repo !== 'string') return false;
  return r.repo === root || r.repo.startsWith(root + path.sep) || r.repo.startsWith(root + '-');
}

function fmtTokens(n) {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return Math.round(n / 1e3) + 'K';
  return String(n);
}

function fmtUsd(n) {
  return '$' + n.toFixed(2);
}

function pct(part, whole) {
  if (!whole) return 0;
  return Math.round((part / whole) * 100);
}

// ---------- phase and sitting ----------

const TAG_FIELDS = new Set(['branch', 'repo', 'subject']);

// A project names its own phases and sittings in <root>/.claude/token-ledger.json:
// {"phase": [{field, pattern, phase}], "sitting": [{field, pattern}]}. In each
// list the first rule that matches wins. A sitting is the match's first group,
// and a match whose first group is not all digits goes on to the next rule.
// A missing file tags nothing, silently; a broken one tags nothing and says so
// on stderr, so the cost line still prints.
function readRules(root) {
  if (!root) return null;
  const file = path.join(root, '.claude', 'token-ledger.json');
  let raw;
  try { raw = fs.readFileSync(file, 'utf8'); } catch { return null; }
  const bad = (why) => { throw new Error(`${file}: ${why}`); };
  let doc;
  try { doc = JSON.parse(raw); } catch { bad('not JSON'); }
  if (!doc || typeof doc !== 'object' || Array.isArray(doc)) bad('not a JSON object');
  const rules = {};
  for (const key of ['phase', 'sitting']) {
    if (doc[key] === undefined) { rules[key] = []; continue; }
    if (!Array.isArray(doc[key])) bad(`"${key}" is not a list`);
    rules[key] = doc[key].map((r, i) => {
      const where = `${key}[${i}]`;
      if (!r || typeof r !== 'object' || !TAG_FIELDS.has(r.field) || typeof r.pattern !== 'string') {
        bad(`${where} is not {field: branch|repo|subject, pattern}`);
      }
      if (key === 'phase' && typeof r.phase !== 'string') bad(`${where} has no string "phase"`);
      let re;
      try { re = new RegExp(r.pattern); } catch (e) { bad(`${where} pattern: ${e.message}`); }
      return { field: r.field, re, phase: r.phase };
    });
  }
  return rules;
}

// A sweep tags many entries of one project, so each project's rules are read
// once per run, and a broken file is reported once.
const rulesByRoot = new Map();

// The entry's `phase` and `sitting`, each present only when a rule matched.
function tagsFor(entry, root) {
  if (!rulesByRoot.has(root)) {
    try { rulesByRoot.set(root, readRules(root)); } catch (e) { rulesByRoot.set(root, e); }
  }
  const rules = rulesByRoot.get(root);
  if (rules instanceof Error) {
    process.stderr.write(`token-ledger: ${rules.message}; no phase or sitting recorded\n`);
    rulesByRoot.set(root, null);
    return {};
  }
  if (!rules) return {};
  const tags = {};
  const value = (r) => (typeof entry[r.field] === 'string' ? entry[r.field] : null);
  for (const r of rules.phase) {
    const v = value(r);
    if (v !== null && r.re.test(v)) { tags.phase = r.phase; break; }
  }
  for (const r of rules.sitting) {
    const v = value(r);
    const m = v === null ? null : r.re.exec(v);
    if (m && /^\d+$/.test(m[1] || '')) { tags.sitting = Number(m[1]); break; }
  }
  return tags;
}

// ---------- transcripts ----------

// A session's lead transcript and subagent directory, in one project directory.
function sessionAt(dir, sessionId) {
  return { file: path.join(dir, sessionId + '.jsonl'), subagentDir: path.join(dir, sessionId, 'subagents') };
}

function findSession(sessionId) {
  let dirs;
  try { dirs = fs.readdirSync(PROJECTS); } catch { return null; }
  for (const d of dirs) {
    const sess = sessionAt(path.join(PROJECTS, d), sessionId);
    if (fs.existsSync(sess.file)) return sess;
  }
  return null;
}

// `lastMs` is the latest counted usage line in the window; `where` is the cwd and branch of the
// latest usage line up to the window's end, counted or not.
function newBucket() {
  return { calls: 0, byModel: {}, lastMs: -Infinity, where: null };
}

function addUsage(bucket, model, u) {
  bucket.calls++;
  let m = bucket.byModel[model];
  if (!m) m = bucket.byModel[model] = { input: 0, cache_w5: 0, cache_w1h: 0, cache_read: 0, output: 0 };
  m.input += u.input_tokens || 0;
  const cc = u.cache_creation || {};
  const w5 = cc.ephemeral_5m_input_tokens || 0;
  const w1h = cc.ephemeral_1h_input_tokens || 0;
  // Older records carry only the total; bill those at the 5-minute rate.
  if (!w5 && !w1h) m.cache_w5 += u.cache_creation_input_tokens || 0;
  else { m.cache_w5 += w5; m.cache_w1h += w1h; }
  m.cache_read += u.cache_read_input_tokens || 0;
  m.output += u.output_tokens || 0;
}

async function scanFile(file, bucket, seen, startMs, endMs) {
  let stream;
  try { stream = fs.createReadStream(file, { encoding: 'utf8' }); } catch { return; }
  const rl = readline.createInterface({ input: stream, crlfDelay: Infinity });
  for await (const line of rl) {
    if (!line || line[0] !== '{') continue;
    let row;
    try { row = JSON.parse(line); } catch { continue; }
    if (row.type !== 'assistant' || !row.message || !row.message.usage) continue;
    const model = row.message.model;
    if (!model || model === '<synthetic>') continue;
    const ts = Date.parse(row.timestamp);
    if (!Number.isFinite(ts) || ts > endMs) continue;
    if (typeof row.cwd === 'string') bucket.where = { cwd: row.cwd, branch: row.gitBranch };
    // One API call is written to several lines, seconds apart at times; the
    // message id de-duplicates it. A call belongs to the window that holds its
    // first line, so an id seen before the start is never counted here.
    const id = row.message.id || (row.requestId && row.requestId + ':' + model);
    if (ts <= startMs) { if (id) seen.add(id); continue; }
    if (!id || seen.has(id)) continue;
    seen.add(id);
    bucket.lastMs = Math.max(bucket.lastMs, ts);
    addUsage(bucket, model, row.message.usage);
  }
}

function subagentFiles(sess) {
  try {
    return fs.readdirSync(sess.subagentDir).filter((f) => f.endsWith('.jsonl')).map((f) => path.join(sess.subagentDir, f));
  } catch { return []; } // a session with no subagents has no directory
}

function filesOf(sess) {
  return [sess.file, ...subagentFiles(sess)];
}

async function collect(sess, startMs, endMs) {
  const lead = newBucket();
  const sub = newBucket();
  const seen = new Set();
  await scanFile(sess.file, lead, seen, startMs, endMs);
  for (const f of subagentFiles(sess)) await scanFile(f, sub, seen, startMs, endMs);
  return { lead, sub };
}

async function firstTimestamp(file) {
  const rl = readline.createInterface({ input: fs.createReadStream(file, { encoding: 'utf8' }), crlfDelay: Infinity });
  for await (const line of rl) {
    if (!line || line[0] !== '{') continue;
    try {
      const ts = Date.parse(JSON.parse(line).timestamp);
      if (Number.isFinite(ts)) { rl.close(); return ts; }
    } catch { /* keep looking */ }
  }
  return Date.now();
}

// ---------- cost ----------

function costOf(bucket, unknown) {
  let usd = 0;
  for (const [model, t] of Object.entries(bucket.byModel)) {
    // A transcript can name a dated snapshot (claude-haiku-4-5-20251001); price it as its alias.
    const p = PRICES.models[model] || PRICES.models[model.replace(/-\d{8}$/, '')];
    if (!p) { unknown.add(model); continue; }
    usd += (t.input * p.input
      + t.cache_w5 * p.cache_write_5m
      + t.cache_w1h * p.cache_write_1h
      + t.cache_read * p.cache_read
      + t.output * p.output) / 1e6;
  }
  return usd;
}

function totalsOf(bucket) {
  const t = { input: 0, cache_w5: 0, cache_w1h: 0, cache_read: 0, output: 0 };
  for (const m of Object.values(bucket.byModel)) {
    for (const k of Object.keys(t)) t[k] += m[k];
  }
  return t;
}

function summarise(lead, sub) {
  const unknown = new Set();
  const leadUsd = costOf(lead, unknown);
  const subUsd = costOf(sub, unknown);
  const lt = totalsOf(lead);
  const st = totalsOf(sub);
  return {
    leadUsd, subUsd, usd: leadUsd + subUsd,
    calls: lead.calls + sub.calls, subCalls: sub.calls,
    cacheRead: lt.cache_read + st.cache_read,
    cacheWrite: lt.cache_w5 + lt.cache_w1h + st.cache_w5 + st.cache_w1h,
    output: lt.output + st.output,
    unknown: [...unknown],
  };
}

function costLine(s) {
  const dollars = fmtUsd(s.usd) + (s.unknown.length ? '+' : '');
  let line = `**Cost:** ${dollars} · ${s.calls} calls (${s.subCalls} subagent)`
    + ` · ${pct(s.leadUsd, s.usd)}% lead · ${pct(s.subUsd, s.usd)}% subagent`
    + ` · ${fmtTokens(s.cacheRead)} cache read · ${fmtTokens(s.cacheWrite)} cache write · ${fmtTokens(s.output)} out`;
  if (s.unknown.length) line += `\n  unpriced model, cost is a floor: ${s.unknown.join(', ')}`;
  return line;
}

// ---------- ledger ----------

function readLedger() {
  let raw;
  try { raw = fs.readFileSync(LEDGER, 'utf8'); } catch { return []; }
  const rows = [];
  for (const line of raw.split('\n')) {
    if (!line) continue;
    try { rows.push(JSON.parse(line)); } catch { /* skip a torn line */ }
  }
  return rows;
}

// Runs under the lock. A ledger whose last byte is not a newline ends in a
// torn line, so the entry starts a line of its own rather than joining it.
function appendLedger(entry) {
  fs.mkdirSync(path.dirname(LEDGER), { recursive: true });
  let sep = '';
  try {
    const fd = fs.openSync(LEDGER, 'r');
    try {
      const { size } = fs.fstatSync(fd);
      const b = Buffer.alloc(1);
      if (size && fs.readSync(fd, b, 0, 1, size - 1) === 1 && b[0] !== 0x0a) sep = '\n';
    } finally { fs.closeSync(fd); }
  } catch { /* no ledger yet */ }
  fs.appendFileSync(LEDGER, sep + JSON.stringify(entry) + '\n');
}

// ---------- the lock ----------
//
// One writer at a time holds <LEDGER>.lock from its ledger read to its append.
// The lock holds the holder's pid and that process's start time, and a writer
// takes over a lock whose holder is gone: exited, or a pid now reused by
// another process. There is no clock in it, so a live holder is waited for.

const LOCK = LEDGER + '.lock';
const GUARD = LOCK + '.takeover';

// `ps` prints the start time in the caller's zone and locale, so every writer
// asks in one zone and one locale, or a live holder reads as a reused pid.
function startTimeOf(pid) {
  try {
    return execFileSync('ps', ['-o', 'lstart=', '-p', String(pid)], {
      encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'], env: { ...process.env, TZ: 'UTC', LC_ALL: 'C' },
    }).trim() || null;
  } catch { return null; }
}

// A lock record that does not parse names no live holder.
function holderOf(raw) {
  try { return JSON.parse(raw); } catch { return null; }
}

// A live pid is a reused one only when both start times are known and differ;
// `withStart` false checks the pid alone, which spawns no `ps`.
function holderGone(rec, withStart = true) {
  if (!rec || !Number.isInteger(rec.pid) || rec.pid <= 0) return true;
  try { process.kill(rec.pid, 0); } catch (e) {
    if (e.code === 'ESRCH') return true;
    if (e.code !== 'EPERM') throw e;
  }
  if (!withStart || typeof rec.start !== 'string') return false;
  const now = startTimeOf(rec.pid);
  return now !== null && now !== rec.start;
}

function sleepMs(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

// Deletes the lock when it still holds the gone record. Only a takeover
// deletes another writer's lock, and a takeover runs under GUARD, a second
// lock taken the same way, so the lock cannot change between the check and
// the delete. A guard whose holder is gone is deleted, and the caller tries
// again. That delete is not guarded, so two writers can take over at once
// only after a writer died inside a takeover.
function takeOver(gone, tmp, mine) {
  try { fs.linkSync(tmp, GUARD); } catch (e) {
    if (e.code !== 'EEXIST') throw e;
    let held = null;
    try { held = fs.readFileSync(GUARD, 'utf8'); } catch { return; }
    if (holderGone(holderOf(held))) { try { fs.unlinkSync(GUARD); } catch { /* another writer did */ } }
    return;
  }
  try {
    let now = null;
    try { now = fs.readFileSync(LOCK, 'utf8'); } catch { return; }
    if (now === gone) fs.unlinkSync(LOCK);
  } finally { release(GUARD, mine); }
}

// Answers the record the lock now holds. The record is written to a file of
// its own and linked into place, so the lock file never appears empty.
// A sweep takes the lock once per session, so this process's record is made once.
let myRecord = null;

function takeLock() {
  fs.mkdirSync(path.dirname(LOCK), { recursive: true });
  const mine = myRecord || (myRecord = JSON.stringify({ pid: process.pid, start: startTimeOf(process.pid) }));
  const tmp = `${LOCK}.${process.pid}`;
  fs.writeFileSync(tmp, mine);
  try {
    let told = false;
    // A waiter checks the pid on every poll and the start time, which spawns
    // `ps`, when the record changes and every 20th poll after.
    let checked = null; let polls = 0;
    for (;;) {
      try { fs.linkSync(tmp, LOCK); return mine; } catch (e) { if (e.code !== 'EEXIST') throw e; }
      let held;
      try { held = fs.readFileSync(LOCK, 'utf8'); } catch (e) {
        if (e.code === 'ENOENT') continue;
        throw e;
      }
      const withStart = held !== checked || ++polls % 20 === 0;
      if (withStart) { checked = held; polls = 0; }
      const holder = holderOf(held);
      if (holderGone(holder, withStart)) { takeOver(held, tmp, mine); continue; }
      const { pid } = holder;
      if (process.env.TOKEN_LEDGER_LOCK_NOWAIT === '1') throw new Error(`the ledger lock is held by pid ${pid}`);
      if (!told) {
        process.stderr.write(`token-ledger: waiting for the ledger lock held by pid ${pid}\n`);
        told = true;
      }
      sleepMs(50);
    }
  } finally {
    try { fs.unlinkSync(tmp); } catch { /* the link keeps the record */ }
  }
}

function release(file, mine) {
  try { if (fs.readFileSync(file, 'utf8') === mine) fs.unlinkSync(file); } catch { /* not ours */ }
}

async function withLock(fn) {
  const mine = takeLock();
  try { return await fn(); } finally { release(LOCK, mine); }
}

// Windows are contiguous: a commit starts where this session's last entry ended,
// so summing entries never counts a token twice.
function lastEndForSession(rows, sessionId) {
  let last = null;
  for (const r of rows) {
    if (r.session !== sessionId || !r.window || !r.window.end) continue;
    const ts = Date.parse(r.window.end);
    if (Number.isFinite(ts) && (last === null || ts > last)) last = ts;
  }
  return last;
}

function readMarkers() {
  try { return JSON.parse(fs.readFileSync(MARKERS, 'utf8')); } catch { return {}; }
}

function writeMarkers(m) {
  fs.mkdirSync(path.dirname(MARKERS), { recursive: true });
  fs.writeFileSync(MARKERS, JSON.stringify(m, null, 2));
}

// ---------- git ----------

function patchIdOf(sha) {
  try {
    // diff-tree is plumbing, so a user's color.ui=always or external diff tool
    // cannot reach the patch; `git show` output under color gave no patch-id.
    const diff = execFileSync('git', ['diff-tree', '-p', '--root', '--no-color', '--no-ext-diff', sha],
      { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 });
    const out = execFileSync('git', ['patch-id', '--stable'], { input: diff, encoding: 'utf8' }).trim();
    return out ? out.split(/\s+/)[0] : null;
  } catch { return null; }
}

function diffStat(sha) {
  const out = gitSafe(['show', '--numstat', '--format=', sha]);
  const stat = { files: 0, insertions: 0, deletions: 0 };
  if (!out) return stat;
  for (const line of out.split('\n')) {
    const parts = line.split('\t');
    if (parts.length < 3) continue;
    stat.files++;
    if (parts[0] !== '-') stat.insertions += Number(parts[0]) || 0;
    if (parts[1] !== '-') stat.deletions += Number(parts[1]) || 0;
  }
  return stat;
}

function sessionId() {
  const id = process.env.CLAUDE_CODE_SESSION_ID;
  if (!id) throw new Error('CLAUDE_CODE_SESSION_ID is unset; run this from inside a Claude Code session');
  return id;
}

async function startFor(sess, rows, id) {
  const last = lastEndForSession(rows, id);
  return last === null ? await firstTimestamp(sess.file) - 1 : last;
}

// A scan is a window and the usage in it: {startMs, endMs, lead, sub}.
async function scanOf(sess, startMs, endMs) {
  return { startMs, endMs, ...await collect(sess, startMs, endMs) };
}

// The usage past `startMs`, up to the last usage line across the lead file
// and its subagent files; null when there is none.
async function tailOf(sess, startMs) {
  const { lead, sub } = await collect(sess, startMs, Infinity);
  if (!lead.calls && !sub.calls) return null;
  return { startMs, endMs: Math.max(lead.lastMs, sub.lastMs), lead, sub };
}

// A writer scans from `startMs` before it takes the lock, so a /commit never
// waits behind a whole scan. Under the lock it re-reads the ledger, and when
// another writer moved the session's start meanwhile, it answers `rescan` of
// the new start instead of `scanned`.
async function rescanIfMoved(sess, id, startMs, scanned, rescan, rows = readLedger()) {
  const now = await startFor(sess, rows, id);
  return now === startMs ? scanned : rescan(now);
}

// A commit's or a ship's rescan: from the moved start to the end it scanned to,
// or to the start itself when the start moved past that end.
function rescanTo(sess, scan0) {
  return (startMs) => scanOf(sess, startMs, Math.max(scan0.endMs, startMs));
}

function windowOf(scan) {
  return { start: new Date(scan.startMs).toISOString(), end: new Date(scan.endMs).toISOString() };
}

function usageOf(scan) {
  return {
    lead: { calls: scan.lead.calls, by_model: scan.lead.byModel },
    sub: { calls: scan.sub.calls, by_model: scan.sub.byModel },
  };
}

// ---------- rootOf ----------

function isDir(p) {
  try { return fs.statSync(p).isDirectory(); } catch { return false; }
}

// A recorded session's repo and project, from a transcript line's cwd rather
// than this process's. A cwd that is gone, as an archived worktree is, answers
// from the path: the project is the cwd cut at /.claude/worktrees/. A sweep
// meets one cwd in many sessions, so each answer is kept for the run.
const rootsByCwd = new Map();

function rootOf(cwd) {
  if (typeof cwd !== 'string' || !cwd) return { repo: null, project: null };
  if (!rootsByCwd.has(cwd)) {
    const cut = cwd.indexOf(path.sep + path.join('.claude', 'worktrees') + path.sep);
    rootsByCwd.set(cwd, (isDir(cwd) && gitRoots(cwd)) || { repo: cwd, project: cut > -1 ? cwd.slice(0, cut) : cwd });
  }
  return rootsByCwd.get(cwd);
}

// ---------- sessions ----------

const SESSION_ID = /^[0-9a-f-]+$/;

function costOfEntry(s) {
  return {
    usd: Number(s.usd.toFixed(4)),
    lead_usd: Number(s.leadUsd.toFixed(4)),
    sub_usd: Number(s.subUsd.toFixed(4)),
    prices_version: PRICES.version,
    partial: s.unknown.length > 0,
    unpriced_models: s.unknown,
  };
}

function sizesOf(sess) {
  return filesOf(sess).map((f) => {
    try { return `${f}:${fs.statSync(f).size}`; } catch { return `${f}:-`; }
  }).join('\n');
}

function sessionEntry(id, via, tail) {
  const where = tail.lead.where || tail.sub.where || {};
  const { repo, project } = rootOf(where.cwd);
  const branch = typeof where.branch === 'string' ? where.branch : null;
  return {
    v: 1,
    kind: 'session',
    ts: new Date(tail.endMs).toISOString(),
    session: id,
    window: windowOf(tail),
    via,
    repo,
    project,
    branch,
    ...tagsFor({ repo, branch }, project),
    ...usageOf(tail),
    cost: costOfEntry(summarise(tail.lead, tail.sub)),
  };
}

// Records the session's usage past its last window as one `session` entry and
// answers it, or null when there is nothing past the window. The hook and the
// sweep both call this, so they cannot disagree on a window. A sweep skips a
// session whose files grow during the scan, because a line flushed after the
// scan but stamped before the end would fall outside every window. A sweep
// passes the session it found and the ledger it read once for every session.
async function recordSession(id, { via, sess = findSession(id), rows = readLedger(), sweep = false, dryRun = false } = {}) {
  if (!sess) throw new Error(`no transcript found for session ${id}`);
  const before = sweep ? sizesOf(sess) : null;
  const startMs = await startFor(sess, rows, id);
  const scanned = await tailOf(sess, startMs);
  if (sweep && sizesOf(sess) !== before) return null;
  // A later start sees no more than this one, so nothing scanned is nothing to record.
  if (!scanned) return null;
  if (dryRun) return sessionEntry(id, via, scanned);
  return withLock(async () => {
    const tail = await rescanIfMoved(sess, id, startMs, scanned, (s) => tailOf(sess, s));
    if (!tail) return null;
    const entry = sessionEntry(id, via, tail);
    appendLedger(entry);
    return entry;
  });
}

// ---------- subcommands ----------

// This process's worktree and project; outside a work tree it throws.
function hereRoots() {
  const roots = gitRoots();
  if (!roots) throw new Error('not inside a git work tree');
  return roots;
}

async function cmdCommit(args) {
  const id = sessionId();
  const sess = findSession(id);
  if (!sess) throw new Error(`no transcript found for session ${id}`);
  const { repo, project } = hereRoots();
  const sha = git(['rev-parse', args.sha || 'HEAD']);
  const start0 = await startFor(sess, readLedger(), id);
  const scan0 = await scanOf(sess, start0, Date.now());
  const stat = diffStat(sha);
  const branch = gitSafe(['rev-parse', '--abbrev-ref', 'HEAD']);
  const subject = gitSafe(['log', '-1', '--format=%s', sha]);
  const tags = tagsFor({ repo, branch, subject }, project);
  const patchId = patchIdOf(sha);

  const s = await withLock(async () => {
    const w = await rescanIfMoved(sess, id, start0, scan0, rescanTo(sess, scan0));
    const sum = summarise(w.lead, w.sub);
    appendLedger({
      v: 1,
      kind: 'commit',
      ts: new Date(w.endMs).toISOString(),
      repo,
      project,
      branch,
      ...tags,
      sha,
      patch_id: patchId,
      subject,
      session: id,
      window: windowOf(w),
      ...usageOf(w),
      cost: costOfEntry(sum),
      files: stat.files,
      insertions: stat.insertions,
      deletions: stat.deletions,
    });
    return sum;
  });

  process.stdout.write(costLine(s) + '\n');
}

// The remote-tracking ref a push lands on: the branch's upstream, or the
// remote's default branch for a worktree branch that has no upstream. A repo
// made with `git init` and `remote add` has no origin/HEAD, so try the usual
// default names after it.
function shipRef() {
  return gitSafe(['rev-parse', '--abbrev-ref', '--symbolic-full-name', '@{u}'])
    || gitSafe(['rev-parse', '--abbrev-ref', 'origin/HEAD'])
    || ['origin/main', 'origin/master'].find((r) => gitSafe(['rev-parse', '--verify', '--quiet', r])) || null;
}

// /ship's doc step commits without going through /commit, under the subject
// lib/commit-format.js recognises, which the commit gate admits by too. A
// ledger entry still wins over the subject (see cmdShip).

function cmdShipBegin() {
  const id = sessionId();
  const repo = git(['rev-parse', '--show-toplevel']);
  const markers = readMarkers();
  const ref = shipRef();
  markers[repo] = {
    ref,
    base: ref ? gitSafe(['rev-parse', ref]) : null,
    branch: gitSafe(['rev-parse', '--abbrev-ref', 'HEAD']),
    session: id,
    ts: new Date().toISOString(),
  };
  writeMarkers(markers);
}

async function cmdShip() {
  const id = sessionId();
  const sess = findSession(id);
  if (!sess) throw new Error(`no transcript found for session ${id}`);
  const { repo, project } = hereRoots();
  const markers = readMarkers();
  const marker = markers[repo];
  const head = git(['rev-parse', 'HEAD']);
  // With no marker, a push that moved the tracking ref to HEAD left the
  // pre-push tip one entry back in that ref's reflog.
  const ref = (marker && marker.ref) || shipRef();
  const pushed = ref && gitSafe(['rev-parse', ref]) === head ? gitSafe(['rev-parse', `${ref}@{1}`]) : null;
  const base = (marker && marker.base) || pushed;
  if (!base) throw new Error('no ship base: run `token-ledger ship-begin` before pushing');
  const shas = (gitSafe(['rev-list', '--reverse', `${base}..${head}`]) || '').split('\n').filter(Boolean);
  const patchIds = new Map(shas.map((sha) => [sha, patchIdOf(sha)]));
  const subjects = new Map();
  for (const line of (gitSafe(['log', '--format=%H %s', `${base}..${head}`]) || '').split('\n')) {
    const sp = line.indexOf(' ');
    if (sp > 0) subjects.set(line.slice(0, sp), line.slice(sp + 1));
  }
  const branch = gitSafe(['rev-parse', '--abbrev-ref', 'HEAD']);
  const tags = tagsFor({ repo, branch }, project);
  // Everything since this session's last ledger entry is the ship's own cost.
  const start0 = await startFor(sess, readLedger(), id);
  const scan0 = await scanOf(sess, start0, Date.now());

  // The matching, the entry and the marker cleanup sit between the lock's
  // ledger read and its append.
  const out = await withLock(async () => {
    const rows = readLedger();
    const w = await rescanIfMoved(sess, id, start0, scan0, rescanTo(sess, scan0), rows);
    const { lead, sub } = w;
    const byPatch = new Map();
    const bySha = new Map();
    // A commit an earlier ship already claimed is not this ship's: base..HEAD
    // reaches back over it when a pull --rebase lands after ship-begin, or when
    // this branch was stacked on one that shipped first. A sha is the same
    // commit in any clone; a patch-id can recur in an unrelated repo, so it
    // only counts within this project.
    const shipped = new Set();
    for (const r of rows) {
      if (r.kind === 'ship') {
        const here = inProject(r, project);
        for (const c of r.commits || []) {
          if (c.sha) shipped.add(c.sha);
          if (c.patch_id && here) shipped.add(c.patch_id);
        }
      }
      if (r.kind !== 'commit') continue;
      if (r.patch_id) byPatch.set(r.patch_id, r);
      if (r.sha) bySha.set(r.sha, r);
    }

    const commits = [];
    const claimed = new Set();
    let matchedUsd = 0; let matchedLead = 0; let matchedSub = 0; let untracked = 0; let skipped = 0;
    let partial = false;
    for (const sha of shas) {
      const pid = patchIds.get(sha);
      if (shipped.has(sha) || (pid && shipped.has(pid))) { skipped++; continue; }
      // Each entry pays once: a later commit that repeats its patch is untracked.
      let entry = (pid && byPatch.get(pid)) || bySha.get(sha) || null;
      if (entry && claimed.has(entry)) entry = null;
      // A ledger entry wins over the subject: /commit can write a docs commit
      // that reads like /ship's own.
      if (!entry && isShipDocs(subjects.get(sha))) {
        commits.push({ sha, patch_id: pid, matched: false, usd: null, docs: true });
        continue;
      }
      if (entry) {
        claimed.add(entry);
        matchedUsd += entry.cost.usd;
        matchedLead += entry.cost.lead_usd;
        matchedSub += entry.cost.sub_usd;
        if (entry.cost.partial) partial = true;
      } else {
        untracked++;
      }
      commits.push({ sha, patch_id: pid, matched: Boolean(entry), usd: entry ? entry.cost.usd : null });
    }

    const o = summarise(lead, sub);
    if (o.unknown.length) partial = true;

    const total = matchedUsd + o.usd;
    const leadUsd = matchedLead + o.leadUsd;
    const subUsd = matchedSub + o.subUsd;
    const plus = partial ? '+' : '';

    appendLedger({
      v: 1,
      kind: 'ship',
      ts: new Date(w.endMs).toISOString(),
      repo,
      project,
      branch,
      ...tags,
      range: `${base}..${head}`,
      session: id,
      window: windowOf(w),
      commits,
      overhead: {
        ...usageOf(w),
        usd: Number(o.usd.toFixed(4)),
      },
      cost: {
        usd: Number(total.toFixed(4)),
        lead_usd: Number(leadUsd.toFixed(4)),
        sub_usd: Number(subUsd.toFixed(4)),
        prices_version: PRICES.version,
        partial,
      },
      untracked,
      skipped,
    });

    if (marker) { delete markers[repo]; writeMarkers(markers); }

    const n = codeCommits(commits);
    let out = `**Ship cost:** ${fmtUsd(total)}${plus} across ${plural(n, 'commit')}`
      + ` (+ ${fmtUsd(o.usd)} ship overhead) · ${pct(leadUsd, total)}% lead · ${pct(subUsd, total)}% subagent`;
    if (untracked) {
      out += `\n  ${plural(untracked, 'commit')} not tracked (committed outside /commit)`;
    }
    return out;
  });
  process.stdout.write(out + '\n');
}

// The commits a ship paid for, leaving out /ship's own docs commit.
function codeCommits(commits) {
  return (commits || []).filter((c) => !c.docs).length;
}

function sinceMs(spec) {
  if (!spec) spec = '14d';
  const m = /^(\d+)([dhw])$/.exec(String(spec));
  if (m) {
    const mult = { h: 3600e3, d: 86400e3, w: 7 * 86400e3 }[m[2]];
    return Date.now() - Number(m[1]) * mult;
  }
  const t = Date.parse(spec);
  return Number.isFinite(t) ? t : Date.now() - 14 * 86400e3;
}

function cmdReport(args) {
  const cutoff = sinceMs(args.since);
  const repo = args.all ? null : projectRoot();
  const by = args.by === 'commit' ? 'commit' : 'ship';
  const inScope = (r) => (!repo || inProject(r, repo)) && Date.parse(r.ts) >= cutoff;
  const ledger = readLedger();
  const rows = ledger.filter((r) => r.kind === by && inScope(r));
  const outside = ledger.filter((r) => r.kind === 'session' && inScope(r));
  const outsideUsd = outside.reduce((sum, r) => sum + ((r.cost && r.cost.usd) || 0), 0);
  const footer = `${plural(outside.length, 'session')} · ${fmtUsd(outsideUsd)} outside any commit`;

  const scope = repo ? path.basename(repo) : 'all repos';
  const head = `${by === 'ship' ? 'Ships' : 'Commits'} — ${scope} — since ${new Date(cutoff).toISOString().slice(0, 10)}`;
  if (!rows.length) { process.stdout.write(head + '\n  (nothing recorded)\n' + footer + '\n'); return; }

  const lines = [head, ''];
  let total = 0; let lead = 0; let sub = 0; let units = 0;
  if (by === 'ship') {
    lines.push('DATE'.padEnd(10) + 'COMMITS'.padStart(7) + 'TOTAL'.padStart(10) + 'LEAD'.padStart(6) + 'SUB'.padStart(7) + '  BRANCH');
    for (const r of rows) {
      const n = codeCommits(r.commits);
      total += r.cost.usd; lead += r.cost.lead_usd; sub += r.cost.sub_usd; units += n;
      lines.push([
        r.ts.slice(0, 10),
        String(n).padStart(7),
        fmtUsd(r.cost.usd).padStart(10),
        (pct(r.cost.lead_usd, r.cost.usd) + '%').padStart(6),
        (pct(r.cost.sub_usd, r.cost.usd) + '%').padStart(7),
        '  ' + (r.branch || ''),
      ].join(''));
    }
  } else {
    lines.push('DATE'.padEnd(10) + '  ' + 'SHA'.padEnd(7) + 'COST'.padStart(10) + 'SUB'.padStart(7) + '  SUBJECT');
    for (const r of rows) {
      total += r.cost.usd; lead += r.cost.lead_usd; sub += r.cost.sub_usd; units++;
      lines.push([
        r.ts.slice(0, 10),
        '  ' + (r.sha || '').slice(0, 7),
        fmtUsd(r.cost.usd).padStart(10),
        (pct(r.cost.sub_usd, r.cost.usd) + '%').padStart(7),
        '  ' + (r.subject || '').slice(0, 44),
      ].join(''));
    }
  }
  lines.push('');
  const mean = units ? total / units : 0;
  const count = by === 'ship'
    ? `${plural(rows.length, 'ship')} · ${plural(units, 'commit')}`
    : plural(units, 'commit');
  lines.push(`${count} · ${fmtUsd(total)} total · ${fmtUsd(mean)} per commit`
    + ` · ${pct(lead, total)}% lead · ${pct(sub, total)}% subagent`);
  lines.push(footer);
  process.stdout.write(lines.join('\n') + '\n');
}

async function cmdRecordSession(args) {
  const id = args._[0];
  if (typeof id !== 'string' || !SESSION_ID.test(id)) throw new Error('usage: token-ledger record-session <session id>');
  await recordSession(id, { via: 'session-end' });
}

// Records every session on disk whose usage runs past its last window: the
// sessions the hook missed. It skips the session it runs inside, whose tail
// is still growing. `--dry-run` takes no lock and appends nothing; both print
// one line per project and a total.
async function cmdSweep(args) {
  // A flag it does not know, or `--dry-run` given a value, would run a real
  // sweep on an append-only ledger, so it refuses both.
  const flags = Object.keys(args).filter((k) => k !== '_');
  if (args._.length || flags.some((k) => k !== 'dry-run' || args[k] !== true)) {
    throw new Error('usage: token-ledger sweep [--dry-run]');
  }
  const dryRun = args['dry-run'] === true;
  const self = process.env.CLAUDE_CODE_SESSION_ID || null;
  const rows = readLedger();
  let dirs = [];
  try { dirs = fs.readdirSync(PROJECTS).sort(); } catch { /* no transcripts */ }
  const byProject = new Map();
  for (const d of dirs) {
    const dir = path.join(PROJECTS, d);
    let files;
    try { files = fs.readdirSync(dir).filter((f) => f.endsWith('.jsonl')).sort(); } catch { continue; }
    for (const f of files) {
      const id = f.slice(0, -'.jsonl'.length);
      if (!SESSION_ID.test(id) || id === self) continue;
      try {
        const entry = await recordSession(id, { via: 'sweep', sess: sessionAt(dir, id), rows, sweep: true, dryRun });
        if (!entry) continue;
        const key = entry.project || '(no project)';
        const t = byProject.get(key) || { usd: 0, n: 0 };
        t.usd += entry.cost.usd; t.n++;
        byProject.set(key, t);
      } catch (err) {
        process.stderr.write(`token-ledger: sweep: ${id}: ${err && err.message ? err.message : String(err)}\n`);
      }
    }
  }
  const lines = [dryRun ? 'Dry run: nothing recorded' : 'Recorded'];
  let usd = 0; let n = 0;
  for (const [project, t] of [...byProject].sort((a, b) => b[1].usd - a[1].usd)) {
    lines.push(`${fmtUsd(t.usd)} · ${plural(t.n, 'session')} · ${project}`);
    usd += t.usd; n += t.n;
  }
  lines.push(`total: ${fmtUsd(usd)} across ${plural(n, 'session')}`);
  process.stdout.write(lines.join('\n') + '\n');
}

function readStdin() {
  return new Promise((resolve) => {
    let s = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (d) => { s += d; });
    process.stdin.on('end', () => resolve(s));
    process.stdin.on('error', () => resolve(s));
  });
}

// The SessionEnd hook. A hook has a 1.5-second budget and a large transcript
// takes longer to scan, so this starts `record-session` detached and returns.
// The session comes from the hook's stdin, never CLAUDE_CODE_SESSION_ID, which
// keeps its first value after /clear. Every refusal exits 0 and spawns
// nothing; the sweep records that session later. The recorder's stderr goes
// to <LEDGER>.errors, so a recorder that always fails leaves a trace.
async function cmdSessionEnd() {
  try {
    const id = JSON.parse(await readStdin())?.session_id;
    if (typeof id !== 'string' || !SESSION_ID.test(id)) return;
    fs.mkdirSync(path.dirname(LEDGER), { recursive: true });
    const errors = fs.openSync(LEDGER + '.errors', 'a');
    let child;
    try {
      child = spawn(process.execPath, [__filename, 'record-session', id],
        { detached: true, stdio: ['ignore', 'ignore', errors] });
    } finally { fs.closeSync(errors); }
    child.on('error', () => {});
    // The suite waits for the recorder rather than polling for its entry.
    if (process.env.TOKEN_LEDGER_SESSION_END_WAIT === '1') {
      await new Promise((r) => { child.once('exit', r); child.once('error', r); });
    }
    else child.unref();
  } catch { /* the sweep records this session later */ }
}

// Diagnostic: cost an arbitrary session or window without recording anything.
async function cmdStats(args) {
  const id = args.session || sessionId();
  const sess = findSession(id);
  if (!sess) throw new Error(`no transcript found for session ${id}`);
  const startMs = args.from ? Date.parse(args.from) : (await firstTimestamp(sess.file)) - 1;
  const endMs = args.to ? Date.parse(args.to) : Date.now();
  const { lead, sub } = await collect(sess, startMs, endMs);
  const unknown = new Set();
  process.stdout.write(JSON.stringify({
    session: id,
    window: { start: new Date(startMs).toISOString(), end: new Date(endMs).toISOString() },
    lead: { calls: lead.calls, totals: totalsOf(lead), usd: Number(costOf(lead, unknown).toFixed(4)), by_model: Object.keys(lead.byModel) },
    sub: { calls: sub.calls, totals: totalsOf(sub), usd: Number(costOf(sub, unknown).toFixed(4)), by_model: Object.keys(sub.byModel) },
    unpriced_models: [...unknown],
    prices_version: PRICES.version,
  }, null, 2) + '\n');
}

// ---------- entry ----------

async function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];
  const args = parseArgs(argv.slice(1));
  switch (cmd) {
    case 'commit': return cmdCommit(args);
    case 'ship-begin': return cmdShipBegin();
    case 'ship': return cmdShip();
    case 'report': return cmdReport(args);
    case 'stats': return cmdStats(args);
    case 'record-session': return cmdRecordSession(args);
    case 'session-end': return cmdSessionEnd();
    case 'sweep': return cmdSweep(args);
    default:
      process.stderr.write('usage: token-ledger <commit|ship-begin|ship|report|stats|record-session|session-end|sweep> [options]\n');
      process.exitCode = 2;
  }
}

main().catch((err) => {
  process.stderr.write('token-ledger: ' + (err && err.message ? err.message : String(err)) + '\n');
  process.exitCode = 1;
});
